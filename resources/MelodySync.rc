// MelodySync.rc -- Windows resource script
//
// WHY THIS FILE EXISTS
//   Without it the linker emits an icon-less PE, so Windows falls back to the
//   generic "unknown application" glyph in Explorer, the taskbar and Alt+Tab.
//   The .ico below carries frames for 16/20/24/32/40/48/64/96/128/256 px,
//   which lets the shell pick a crisp bitmap for every view size instead of
//   scaling one of them down.
//
// KEEP THIS FILE ASCII-ONLY
//   rc.exe reads a .rc script using the system ANSI code page (CP936 on a
//   Chinese Windows install) unless the file starts with
//   "#pragma code_page(65001)". A Chinese comment written here as UTF-8 would
//   therefore be mis-decoded and can abort the resource compile. Comments in
//   this particular file stay in English on purpose -- everything else in the
//   project is UTF-8 + /utf-8, but the resource compiler is a separate beast.
//
// PATH RESOLUTION
//   rc.exe resolves resource file names relative to the directory holding this
//   .rc script, so "icons/melodysync.ico" means
//   resources/icons/melodysync.ico. The icon is produced by tools/make_icon.py.

#include <windows.h>

// ID 1 is the lowest legal icon resource id and the one the shell treats as
// the application icon by default.
1 ICON "icons/melodysync.ico"
