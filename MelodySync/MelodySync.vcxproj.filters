    <ClInclude Include="..\src\search\sources\JamendoSource.h">
      <Filter>src\search\sources</Filter>
    </ClInclude>
    <ClInclude Include="..\src\search\sources\FmaSource.h">
      <Filter>src\search\sources</Filter>
    </ClInclude>
    <ClInclude Include="..\src\search\sources\ArchiveSource.h">
      <Filter>src\search\sources</Filter>
    </ClInclude>
    <ClInclude Include="..\src\search\sources\PixabaySource.h">
      <Filter>src\search\sources</Filter>
    </ClInclude>
    <ClInclude Include="..\src\search\sources\PreviewSource.h">
      <Filter>src\search\sources</Filter>
    </ClInclude>
    <ClInclude Include="..\src\search\sources\WebSource.h">
      <Filter>src\search\sources</Filter>
    </ClInclude>
    <ClInclude Include="..\src\playlist\PlaylistParser.h">
      <Filter>src\playlist</Filter>
    </ClInclude>
    <ClInclude Include="..\src\playlist\NeteaseApi.h">
      <Filter>src\playlist</Filter>
    </ClInclude>
    <ClInclude Include="..\src\playlist\QQMusicApi.h">
      <Filter>src\playlist</Filter>
    </ClInclude>
    <ClInclude Include="..\src\download\DownloadEngine.h">
      <Filter>src\download</Filter>
    </ClInclude>
    <ClInclude Include="..\src\download\YtDlpWrapper.h">
      <Filter>src\download</Filter>
    </ClInclude>
    <ClInclude Include="..\src\audio\TagWriter.h">
      <Filter>src\audio</Filter>
    </ClInclude>
    <ClInclude Include="..\src\audio\FFmpegTranscoder.h">
      <Filter>src\audio</Filter>
    </ClInclude>
    <ClInclude Include="..\src\device\DeviceManager.h">
      <Filter>src\device</Filter>
    </ClInclude>
    <ClInclude Include="..\src\device\MtpSync.h">
      <Filter>src\device</Filter>
    </ClInclude>
    <ClInclude Include="..\src\device\UsbSync.h">
      <Filter>src\device</Filter>
    </ClInclude>
    <ClInclude Include="..\src\settings\Settings.h">
      <Filter>src\settings</Filter>
    </ClInclude>
  </ItemGroup>

  <ItemGroup>
    <ResourceCompile Include="..\resources\MelodySync.rc">
      <Filter>resources</Filter>
    </ResourceCompile>
    <QtRcc Include="..\resources\resources.qrc">
      <Filter>resources</Filter>
    </QtRcc>
    <None Include="..\ui\index.html">
      <Filter>ui</Filter>
    </None>
    <None Include="..\installer\MelodySync.iss">
      <Filter>installer</Filter>
    </None>
  </ItemGroup>
</Project>
