    <ClCompile Include="..\src\download\YtDlpWrapper.cpp">
      <Filter>src\download</Filter>
    </ClCompile>
    <ClCompile Include="..\src\audio\TagWriter.cpp">
      <Filter>src\audio</Filter>
    </ClCompile>
    <ClCompile Include="..\src\audio\FFmpegTranscoder.cpp">
      <Filter>src\audio</Filter>
    </ClCompile>
    <ClCompile Include="..\src\device\DeviceManager.cpp">
      <Filter>src\device</Filter>
    </ClCompile>
    <ClCompile Include="..\src\device\MtpSync.cpp">
      <Filter>src\device</Filter>
    </ClCompile>
    <ClCompile Include="..\src\device\UsbSync.cpp">
      <Filter>src\device</Filter>
    </ClCompile>
    <ClCompile Include="..\src\settings\Settings.cpp">
      <Filter>src\settings</Filter>
    </ClCompile>
  </ItemGroup>

  <ItemGroup>
    <ClInclude Include="..\src\MainWindow.h">
      <Filter>src</Filter>
    </ClInclude>
    <ClInclude Include="..\src\core\Types.h">
      <Filter>src\core</Filter>
    </ClInclude>
    <ClInclude Include="..\src\core\HttpClient.h">
      <Filter>src\core</Filter>
    </ClInclude>
    <ClInclude Include="..\src\core\Async.h">
      <Filter>src\core</Filter>
    </ClInclude>
    <ClInclude Include="..\src\data\Database.h">
      <Filter>src\data</Filter>
    </ClInclude>
    <ClInclude Include="..\src\bridge\WebBridge.h">
      <Filter>src\bridge</Filter>
    </ClInclude>
    <ClInclude Include="..\src\bridge\LocalAudioServer.h">
      <Filter>src\bridge</Filter>
    </ClInclude>
    <ClInclude Include="..\src\auth\UserManager.h">
      <Filter>src\auth</Filter>
    </ClInclude>
    <ClInclude Include="..\src\auth\CloudSync.h">
      <Filter>src\auth</Filter>
    </ClInclude>
    <ClInclude Include="..\src\ai\AiClient.h">
      <Filter>src\ai</Filter>
    </ClInclude>
    <ClInclude Include="..\src\ai\IntentParser.h">
      <Filter>src\ai</Filter>
    </ClInclude>
    <ClInclude Include="..\src\search\SearchSource.h">
      <Filter>src\search</Filter>
